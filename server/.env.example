# Notely Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (If omitted or unreachable, server will automatically use in-memory DB)
MONGODB_URI=mongodb://127.0.0.1:27017/notely

# JWT Authentication Secret & Expiration
JWT_SECRET=notely_super_secret_jwt_key_2026_prod
JWT_EXPIRES_IN=7d

# Allowed Client Origin URL for CORS
CLIENT_URL=http://localhost:5173
